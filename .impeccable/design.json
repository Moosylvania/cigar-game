  "narrative": {
    "northStar": "The Illustrated Production Town",
    "overview": "The playable map leads. Buildings use crisp Canvas 2D silhouettes, dark\noutlines, pale walls, and distinct coral, teal, blue, yellow, and mauve roofs.\nBuilding and object art is authored in Canvas 2D. The meadow uses a local,\noptimized Higgsfield Z Image texture, generated for 0.15 credits.",
    "keyCharacteristics": [],
    "rules": [
      {
        "name": "The Shared Artwork Rule.",
        "body": "The build menu, upgrade panels, fleet picker, and\ndecoration store use animated Canvas previews from the same renderers as the\nmap. Visible previews share one 20fps clock and skip offscreen/hidden painting.",
        "section": "components"
      },
      {
        "name": "The Fixed Footprint Rule.",
        "body": "Motion affects artwork, never placement bounds,\nlabels, or status hit targets. Real production time remains independent of\nambient motion.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve gameplay, save compatibility, and recognizable building roles.",
      "Do use existing MDI icons for controls and descriptive button titles.",
      "Do keep production and upgrade counters active when ambient motion is off."
    ],
    "donts": [
      "Don't move click targets with animation.",
      "Don't spend generation credits without checking the user's budget."
    ]
