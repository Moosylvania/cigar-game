      "html": "<div class=\"ds-map-controls\"><button class=\"ds-map-button\" title=\"Zoom in\" aria-label=\"Zoom in\">+</button></div>",
      "css": ".ds-map-controls { display:inline-flex; padding:2px; background:#202c28; border:1px solid #4d6258; border-radius:4px; } .ds-map-button { display:flex; align-items:center; justify-content:center; width:40px; height:40px; border:0; border-radius:4px; background:transparent; color:#eee9dc; font-family:\"Trebuchet MS\",sans-serif; font-size:1.1rem; cursor:pointer; transition:background-color 140ms ease,border-color 140ms ease,transform 140ms ease; } .ds-map-button:hover { background:rgba(212,169,74,.18); filter:brightness(.96); } .ds-map-button:focus-visible { outline:3px solid #dfb866; outline-offset:3px; } .ds-map-button:active { transform:translateY(1px); } @media (prefers-reduced-motion:reduce) { .ds-map-button { transition:none; } }"
